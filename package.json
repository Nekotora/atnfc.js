{
  "name": "atnfc.js",
  "version": "0.1.0",
  "description": "TypeScript client for ATNFC serial NFC modules.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/nekotora/atnfc.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekotora/atnfc.js.git"
  },
  "keywords": [
    "atnfc",
    "nfc",
    "webserial",
    "serial",
    "typescript",
    "mifare",
    "ntag",
    "iso15693",
    "iso14443"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AT_COMMAND_REFERENCE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-serial": {
      "types": "./dist/web-serial.d.ts",
      "import": "./dist/web-serial.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example:dev": "vite --host 127.0.0.1 --port 5173 example",
    "example:build": "vite build example",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  }
}
